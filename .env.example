# Copie para .env (local) ou cadastre estas variáveis no Railway.
# Conexão com o PostgreSQL (obrigatória)
DATABASE_URL=postgres://usuario:senha@localhost:5432/yardsync

# Segredo para assinar os tokens de login (obrigatório em produção; use um texto longo e aleatório)
AUTH_SECRET=troque-por-um-texto-longo-e-aleatorio

# Senha do primeiro usuário "admin" (se vazia, o servidor gera uma e mostra no log uma única vez)
ADMIN_PASSWORD=

# Chave só de leitura usada pela macro do Excel (opcional)
EXCEL_API_KEY=

# Fuso horário usado em "entregas de hoje" e "atrasados"
APP_TZ=America/Sao_Paulo

# Em produção (Railway) use: NODE_ENV=production
# Dados de exemplo: só são criados fora de produção, ou com SEED_DEMO=true
NODE_ENV=development
PORT=3000
